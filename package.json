{
  "name": "custent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node --import tsx scripts/e2e.ts",
    "e2e:install": "playwright install chromium",
    "db:migrate": "tsx scripts/migrate.ts",
    "provider:verify": "tsx scripts/verify-provider.ts",
    "provider:verify-reasoning": "tsx scripts/verify-reasoning.ts",
    "provider:verify-tools": "tsx scripts/verify-provider-tools.ts",
    "worker": "tsx scripts/agent-worker.ts",
    "worker:dev": "tsx watch scripts/agent-worker.ts",
    "runs:reaper": "tsx scripts/run-reaper.ts",
    "attachments:worker": "tsx scripts/input-attachment-worker.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "5.3.0",
    "@openai/agents": "0.17.0",
    "busboy": "1.6.0",
    "fast-xml-parser": "5.11.0",
    "highlight.js": "11.11.1",
    "next": "16.3.2",
    "openai": "7.5.0",
    "parse-entities": "4.0.2",
    "pdfjs-dist": "6.2.108",
    "pdfkit": "0.20.1",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/busboy": "1.5.4",
    "@types/node": "26.2.0",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.2",
    "tsx": "4.23.12",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  }
}
