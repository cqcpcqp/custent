# Change both values if port 5432 is already used locally. Docker Compose and
# the migration script both read this root-level .env file.
CUSTENT_DB_PORT=5432
DATABASE_URL=postgres://custent:custent@localhost:5432/custent
OPENAI_API_KEY=sk-your-api-key
OPENAI_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6
# Enable only when the configured Responses provider accepts reasoning.mode.
# Keep false for providers that support reasoning effort/summary but reject mode.
OPENAI_REASONING_MODE_ENABLED=false
# Keep disabled until the configured provider has passed the explicit
# code_interpreter_container_lifecycle capability probe and product metering is configured.
OPENAI_CODE_INTERPRETER_ENABLED=false

# Demo account used by the MVP until real authentication is added.
DEMO_USER_ID=11111111-1111-4111-8111-111111111111

# Platform-credit policy. These are product points, not OpenAI prices.
RUN_RESERVATION_CREDITS=500
CREDITS_PER_1K_INPUT_TOKENS=1
CREDITS_PER_1K_OUTPUT_TOKENS=5
CREDITS_PER_WEB_SEARCH=10

# Durable background execution. Start Next.js, the Agent worker, and the Run
# Reaper as separate long-running processes (`pnpm dev`, `pnpm worker:dev`, and
# `pnpm runs:reaper` locally).
# One worker executes at most this many runs concurrently.
RUN_WORKER_CONCURRENCY=2
# Queue polling interval while a worker is idle, in milliseconds.
RUN_WORKER_POLL_MS=250
# Lease duration in milliseconds. The validated minimum is 10000. Workers
# renew the lease and check cancellation every min(1000ms, RUN_LEASE_MS / 3).
RUN_LEASE_MS=30000
# Independent abandoned-Run recovery. The reaper scans immediately on startup,
# then waits this many milliseconds between bounded batches. Minimum: 1000ms.
RUN_RECOVERY_INTERVAL_MS=5000
# Maximum Runs recovered per scan. Valid range: 1..1000.
RUN_RECOVERY_BATCH_SIZE=100
# Database polling interval used by the persisted-event SSE relay. This only
# controls activity viewing; disconnecting SSE does not cancel the worker run.
RUN_EVENT_POLL_MS=250

ARTIFACT_DIR=.data/artifacts
# Optional absolute path to a PDFKit-compatible font file for CJK output.
PDF_FONT_PATH=

# User-provided prompt attachments. Files are staged locally until a message
# binds them. Supported files: UTF-8 TXT/CSV/Markdown/JSON, PDF, DOCX, XLSX,
# PPTX, PNG, JPEG, WebP, and non-animated GIF. MIME, extension, and file bytes
# are validated before an attachment is published.
INPUT_ATTACHMENT_DIR=.data/input-attachments
# Per-file, per-message count, and per-message aggregate byte limits. The
# frontend receives these exact server limits through the bootstrap contract.
INPUT_ATTACHMENT_MAX_BYTES=10485760
INPUT_ATTACHMENT_MAX_PER_MESSAGE=5
INPUT_ATTACHMENT_MAX_TOTAL_BYTES=20971520
INPUT_ATTACHMENT_STAGED_TTL_HOURS=24
INPUT_ATTACHMENT_SWEEP_INTERVAL_MS=60000
INPUT_ATTACHMENT_DELETE_RETRY_MS=30000
INPUT_ATTACHMENT_SWEEP_BATCH_SIZE=100
# A published UUID file is considered for orphan reconciliation only after
# this independent safety age. The validated minimum is 300000ms.
INPUT_ATTACHMENT_ORPHAN_MIN_AGE_MS=3600000
# Project-format temporary upload files are stale only after this age. The
# validated minimum is 300000ms.
INPUT_ATTACHMENT_TEMP_STALE_AGE_MS=3600000
